{
  "name": "passline",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm test:int",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > lib/db/types.gen.ts",
    "seed": "node scripts/not-implemented.mjs seed S1",
    "gen:qr-video": "node scripts/not-implemented.mjs gen:qr-video S5"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "pg": "^8.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
