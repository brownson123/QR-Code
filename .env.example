# SPEC §19. Copy to .env.local for `pnpm dev`. Values below target the local Supabase stack;
# run `supabase status -o env` to get the local keys.

NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# >= 32 random bytes each: `openssl rand -hex 32`
SHEET_INGEST_SECRET=
DRAIN_SECRET=

# Only needed for "Sync now" (S3). Read-only Sheets scope.
GOOGLE_SERVICE_ACCOUNT_JSON=

# console | resend. Dev and test MUST use console.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=

# Test-only (not read by the app). Integration tests refuse any non-local host.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
